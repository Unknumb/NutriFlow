      <bpmndi:BPMNEdge id="Edge_bc_sf11" bpmnElement="bc_sf11"><di:waypoint x="1660" y="700"/><di:waypoint x="1660" y="720"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_bc_sf12" bpmnElement="bc_sf12"><di:waypoint x="1550" y="810"/><di:waypoint x="1592" y="810"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_bc_sf13" bpmnElement="bc_sf13"><di:waypoint x="1730" y="810"/><di:waypoint x="1660" y="840"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_bc_sf14" bpmnElement="bc_sf14"><di:waypoint x="1800" y="840"/><di:waypoint x="1842" y="840"/></bpmndi:BPMNEdge>

      <!-- BC artefacto: asociaciones (peine vía trunk y=600, libre de cajas en todo el ancho del pool) -->
      <bpmndi:BPMNEdge id="Edge_assoc_ta_nc1" bpmnElement="assoc_ta_nc1"><di:waypoint x="1230" y="660"/><di:waypoint x="1230" y="600"/><di:waypoint x="650" y="600"/><di:waypoint x="650" y="780"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_assoc_ta_nc2" bpmnElement="assoc_ta_nc2"><di:waypoint x="1410" y="660"/><di:waypoint x="1410" y="600"/><di:waypoint x="650" y="600"/><di:waypoint x="650" y="800"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_assoc_ta_nc3" bpmnElement="assoc_ta_nc3"><di:waypoint x="1590" y="660"/><di:waypoint x="1590" y="600"/><di:waypoint x="650" y="600"/><di:waypoint x="650" y="820"/></bpmndi:BPMNEdge>

      <!-- ── Pool Backend-Math (y=900, h=300) ── -->
      <bpmndi:BPMNShape id="Shape_Pool_BackendMath" bpmnElement="Pool_BackendMath" isHorizontal="true">
        <dc:Bounds x="20" y="900" width="2400" height="300" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_BM_CalcTMB" bpmnElement="Task_BM_CalcTMB">
        <dc:Bounds x="1050" y="960" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_BM_TMB" bpmnElement="End_BM_TMB">
        <dc:Bounds x="1232" y="982" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_BM_Cuadrador" bpmnElement="Task_BM_Cuadrador">
        <dc:Bounds x="1230" y="960" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_BM_Cuad" bpmnElement="End_BM_Cuad">
        <dc:Bounds x="1412" y="982" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_BM_ArmarPauta" bpmnElement="Task_BM_ArmarPauta">
        <dc:Bounds x="1410" y="960" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_BM_Pauta" bpmnElement="End_BM_Pauta">
        <dc:Bounds x="1592" y="982" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_BM_ValidarPizarra" bpmnElement="Task_BM_ValidarPizarra">
        <dc:Bounds x="1590" y="960" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_PizarraOk" bpmnElement="GW_PizarraOk" isMarkerVisible="true">
        <dc:Bounds x="1775" y="975" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_BM_PizOk" bpmnElement="End_BM_PizOk">
        <dc:Bounds x="1777" y="910" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_BM_PizErr" bpmnElement="End_BM_PizErr">
        <dc:Bounds x="1777" y="1100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_BM_SugerirMenus" bpmnElement="Task_BM_SugerirMenus">
        <dc:Bounds x="1660" y="1080" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_BM_Menu" bpmnElement="End_BM_Menu">
        <dc:Bounds x="1842" y="1102" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- BM sequence flow edges -->
      <bpmndi:BPMNEdge id="Edge_bm_sf1"     bpmnElement="bm_sf1"><di:waypoint x="1190" y="1000"/><di:waypoint x="1232" y="1000"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_bm_sf2"     bpmnElement="bm_sf2"><di:waypoint x="1370" y="1000"/><di:waypoint x="1412" y="1000"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_bm_sf3"     bpmnElement="bm_sf3"><di:waypoint x="1550" y="1000"/><di:waypoint x="1592" y="1000"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_bm_sf4"     bpmnElement="bm_sf4"><di:waypoint x="1730" y="1000"/><di:waypoint x="1775" y="1000"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_bm_sf5_ok"  bpmnElement="bm_sf5_ok"><di:waypoint x="1800" y="975"/><di:waypoint x="1800" y="946"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_bm_sf5_err" bpmnElement="bm_sf5_err"><di:waypoint x="1800" y="1025"/><di:waypoint x="1800" y="1100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_bm_sf6"     bpmnElement="bm_sf6"><di:waypoint x="1800" y="1120"/><di:waypoint x="1842" y="1120"/></bpmndi:BPMNEdge>

      <!-- ── Message flows (entre pools) ── -->
      <!-- Auth: login con contraseña -->
      <bpmndi:BPMNEdge id="Edge_mf_login_req"  bpmnElement="mf_login_req">
        <di:waypoint x="290" y="190"/><di:waypoint x="220" y="500"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_login_res"  bpmnElement="mf_login_res">
        <di:waypoint x="250" y="500"/><di:waypoint x="310" y="190"/>
      </bpmndi:BPMNEdge>

      <!-- Crear Paciente -->
      <bpmndi:BPMNEdge id="Edge_mf_crearPac_req" bpmnElement="mf_crearPac_req">
        <di:waypoint x="1240" y="180"/><di:waypoint x="760" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_crearPac_res" bpmnElement="mf_crearPac_res">
        <di:waypoint x="780" y="480"/><di:waypoint x="1260" y="180"/>
      </bpmndi:BPMNEdge>

      <!-- Evaluación (elbow vía trunk del hueco entre pools, evita cruzar ObtenerMetricas) -->
      <bpmndi:BPMNEdge id="Edge_mf_eval_req" bpmnElement="mf_eval_req">
        <di:waypoint x="1420" y="260"/><di:waypoint x="1420" y="445"/><di:waypoint x="940" y="445"/><di:waypoint x="940" y="620"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_eval_res" bpmnElement="mf_eval_res">
        <di:waypoint x="960" y="620"/><di:waypoint x="960" y="455"/><di:waypoint x="1440" y="455"/><di:waypoint x="1440" y="260"/>
      </bpmndi:BPMNEdge>

      <!-- Dashboard TMB FE → Core -->
      <bpmndi:BPMNEdge id="Edge_mf_tmb_fe_req" bpmnElement="mf_tmb_fe_req">
        <di:waypoint x="1600" y="260"/><di:waypoint x="1120" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_tmb_fe_res" bpmnElement="mf_tmb_fe_res">
        <di:waypoint x="1140" y="480"/><di:waypoint x="1620" y="260"/>
      </bpmndi:BPMNEdge>

      <!-- TMB Core → Math -->
      <bpmndi:BPMNEdge id="Edge_mf_tmb_req" bpmnElement="mf_tmb_req">
        <di:waypoint x="1120" y="700"/><di:waypoint x="1120" y="960"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_tmb_res" bpmnElement="mf_tmb_res">
        <di:waypoint x="1140" y="960"/><di:waypoint x="1140" y="700"/>
      </bpmndi:BPMNEdge>

      <!-- Macros FE → Core -->
      <bpmndi:BPMNEdge id="Edge_mf_macro_fe_req" bpmnElement="mf_macro_fe_req">
        <di:waypoint x="1780" y="260"/><di:waypoint x="1300" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_macro_fe_res" bpmnElement="mf_macro_fe_res">
        <di:waypoint x="1320" y="480"/><di:waypoint x="1800" y="260"/>
      </bpmndi:BPMNEdge>

      <!-- Cuadrador Core → Math (inalcanzable en runtime, pero el cableado existe) -->
      <bpmndi:BPMNEdge id="Edge_mf_macro_req" bpmnElement="mf_macro_req">
        <di:waypoint x="1300" y="700"/><di:waypoint x="1300" y="960"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_macro_res" bpmnElement="mf_macro_res">
        <di:waypoint x="1320" y="960"/><di:waypoint x="1320" y="700"/>
      </bpmndi:BPMNEdge>

      <!-- Pauta FE → Core -->
      <bpmndi:BPMNEdge id="Edge_mf_pauta_fe_req" bpmnElement="mf_pauta_fe_req">
        <di:waypoint x="1780" y="400"/><di:waypoint x="1480" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_pauta_fe_res" bpmnElement="mf_pauta_fe_res">
        <di:waypoint x="1500" y="480"/><di:waypoint x="1800" y="400"/>
      </bpmndi:BPMNEdge>

      <!-- Armador Core → Math (NO implementado en backend-core; el endpoint sí existe en backend-math) -->
      <bpmndi:BPMNEdge id="Edge_mf_pauta_req" bpmnElement="mf_pauta_req">
        <di:waypoint x="1480" y="700"/><di:waypoint x="1480" y="960"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_pauta_res" bpmnElement="mf_pauta_res">
        <di:waypoint x="1500" y="960"/><di:waypoint x="1500" y="700"/>
      </bpmndi:BPMNEdge>

      <!-- Guardar distribución FE → Core -->
      <bpmndi:BPMNEdge id="Edge_mf_guardarDist_req" bpmnElement="mf_guardarDist_req">
        <di:waypoint x="1960" y="400"/><di:waypoint x="1660" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_guardarDist_res" bpmnElement="mf_guardarDist_res">
        <di:waypoint x="1680" y="480"/><di:waypoint x="1980" y="400"/>
      </bpmndi:BPMNEdge>

      <!-- Pizarra Core → Math (NO implementado en backend-core; el endpoint sí existe en backend-math) -->
      <bpmndi:BPMNEdge id="Edge_mf_pizarra_req" bpmnElement="mf_pizarra_req">
        <di:waypoint x="1660" y="700"/><di:waypoint x="1660" y="960"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_pizarra_res" bpmnElement="mf_pizarra_res">
        <di:waypoint x="1680" y="960"/><di:waypoint x="1680" y="700"/>
      </bpmndi:BPMNEdge>

      <!-- Planificación FE → Core (elbow por el hueco de columna x=1390/1405, evita GuardarDistribucion/ValidarPizarra) -->
      <bpmndi:BPMNEdge id="Edge_mf_plan_req" bpmnElement="mf_plan_req">
        <di:waypoint x="2022" y="220"/><di:waypoint x="2022" y="445"/><di:waypoint x="1390" y="445"/><di:waypoint x="1390" y="790"/><di:waypoint x="1410" y="790"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_plan_res" bpmnElement="mf_plan_res">
        <di:waypoint x="1410" y="800"/><di:waypoint x="1405" y="800"/><di:waypoint x="1405" y="455"/><di:waypoint x="2032" y="455"/><di:waypoint x="2032" y="230"/>
      </bpmndi:BPMNEdge>

      <!-- Menús FE → Core (elbow por el espacio libre a la derecha de ProxyMenus/GenerarMenus, x=1810/1830) -->
      <bpmndi:BPMNEdge id="Edge_mf_menu_fe_req" bpmnElement="mf_menu_fe_req">
        <di:waypoint x="2260" y="140"/><di:waypoint x="2265" y="140"/><di:waypoint x="2265" y="445"/><di:waypoint x="1810" y="445"/><di:waypoint x="1810" y="790"/><di:waypoint x="1800" y="790"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_menu_fe_res" bpmnElement="mf_menu_fe_res">
        <di:waypoint x="1800" y="800"/><di:waypoint x="1830" y="800"/><di:waypoint x="1830" y="455"/><di:waypoint x="2280" y="455"/><di:waypoint x="2280" y="150"/>
      </bpmndi:BPMNEdge>

      <!-- Menús Core → Math -->
      <bpmndi:BPMNEdge id="Edge_mf_menu_req" bpmnElement="mf_menu_req">
        <di:waypoint x="1730" y="880"/><di:waypoint x="1730" y="1080"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_mf_menu_res" bpmnElement="mf_menu_res">
        <di:waypoint x="1750" y="1080"/><di:waypoint x="1750" y="880"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
