<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://nutriflow.cl/bpmn"
             id="NutriFlow_Definitions">

  <collaboration id="NutriFlow_Collaboration">
    <participant id="Pool_Frontend"    name="Nutricionista (Frontend React)"  processRef="Process_Frontend" />
    <participant id="Pool_BackendCore" name="backend-core (NestJS / Postgres)" processRef="Process_BackendCore" />
    <participant id="Pool_BackendMath" name="backend-math (FastAPI / Cálculos)" processRef="Process_BackendMath" />

    <!-- ── Autenticación ── -->
    <messageFlow id="mf_login_req"   sourceRef="Task_Login"          targetRef="Task_BC_ValidarJWT" />
    <messageFlow id="mf_login_res"   sourceRef="Task_BC_ValidarJWT"  targetRef="Task_Login" />

    <!-- ── Crear Paciente ── -->
    <messageFlow id="mf_crearPac_req" sourceRef="Task_CrearPaciente"      targetRef="Task_BC_CrearPaciente" />
    <messageFlow id="mf_crearPac_res" sourceRef="Task_BC_CrearPaciente"   targetRef="Task_CrearPaciente" />

    <!-- ── Evaluación ── -->
    <messageFlow id="mf_eval_req"  sourceRef="Task_RegistrarEval"     targetRef="Task_BC_GuardarEval" />
    <messageFlow id="mf_eval_res"  sourceRef="Task_BC_GuardarEval"    targetRef="Task_RegistrarEval" />

    <!-- ── TMB Core → Math ── -->
    <messageFlow id="mf_tmb_req"  sourceRef="Task_BC_LlamarTMB"    targetRef="Task_BM_CalcTMB" />
    <messageFlow id="mf_tmb_res"  sourceRef="Task_BM_CalcTMB"      targetRef="Task_BC_LlamarTMB" />

    <!-- ── TMB Frontend ← Core ── -->
    <messageFlow id="mf_tmb_fe_req"  sourceRef="Task_VerDashboard"     targetRef="Task_BC_ObtenerMetricas" />
    <messageFlow id="mf_tmb_fe_res"  sourceRef="Task_BC_ObtenerMetricas" targetRef="Task_VerDashboard" />

    <!-- ── Macros Core → Math ── -->
    <messageFlow id="mf_macro_req"  sourceRef="Task_BC_LlamarCuadrador"  targetRef="Task_BM_Cuadrador" />
    <messageFlow id="mf_macro_res"  sourceRef="Task_BM_Cuadrador"        targetRef="Task_BC_LlamarCuadrador" />

    <!-- ── Macros Frontend ← Core ── -->
    <messageFlow id="mf_macro_fe_req"  sourceRef="Task_ConfigMacros"         targetRef="Task_BC_GuardarMacros" />
    <messageFlow id="mf_macro_fe_res"  sourceRef="Task_BC_GuardarMacros"     targetRef="Task_ConfigMacros" />

    <!-- ── Pauta Core → Math ── -->
    <messageFlow id="mf_pauta_req"  sourceRef="Task_BC_ArmarPauta"   targetRef="Task_BM_ArmarPauta" />
    <messageFlow id="mf_pauta_res"  sourceRef="Task_BM_ArmarPauta"   targetRef="Task_BC_ArmarPauta" />

    <!-- ── Pauta Frontend ← Core ── -->
    <messageFlow id="mf_pauta_fe_req"  sourceRef="Task_ArmadoPorciones"      targetRef="Task_BC_ObtenerDistribucion" />
    <messageFlow id="mf_pauta_fe_res"  sourceRef="Task_BC_ObtenerDistribucion" targetRef="Task_ArmadoPorciones" />

    <!-- ── Guardar Distribución ── -->
    <messageFlow id="mf_guardarDist_req" sourceRef="Task_GuardarPauta"        targetRef="Task_BC_GuardarDistribucion" />
    <messageFlow id="mf_guardarDist_res" sourceRef="Task_BC_GuardarDistribucion" targetRef="Task_GuardarPauta" />

    <!-- ── Pizarra Core → Math ── -->
    <messageFlow id="mf_pizarra_req"  sourceRef="Task_BC_ValidarPizarra"  targetRef="Task_BM_ValidarPizarra" />
    <messageFlow id="mf_pizarra_res"  sourceRef="Task_BM_ValidarPizarra"  targetRef="Task_BC_ValidarPizarra" />

    <!-- ── Planificación ── -->
    <messageFlow id="mf_plan_req"  sourceRef="Task_GuardarPlanificacion"     targetRef="Task_BC_CrearPlanificacion" />
    <messageFlow id="mf_plan_res"  sourceRef="Task_BC_CrearPlanificacion"    targetRef="Task_GuardarPlanificacion" />

    <!-- ── Menús Core → Math ── -->
    <messageFlow id="mf_menu_req"  sourceRef="Task_BC_GenerarMenus"    targetRef="Task_BM_SugerirMenus" />
    <messageFlow id="mf_menu_res"  sourceRef="Task_BM_SugerirMenus"    targetRef="Task_BC_GenerarMenus" />

    <!-- ── Menús Frontend ← Core ── -->
    <messageFlow id="mf_menu_fe_req"  sourceRef="Task_SolicitarMenus"         targetRef="Task_BC_ProxyMenus" />
    <messageFlow id="mf_menu_fe_res"  sourceRef="Task_BC_ProxyMenus"          targetRef="Task_SolicitarMenus" />
  </collaboration>

  <!-- ═══════════════════════════════════════════════════════════
       PROCESO: FRONTEND (Nutricionista)
       ═══════════════════════════════════════════════════════════ -->
  <process id="Process_Frontend" name="Frontend NutriFlow" isExecutable="false">

    <startEvent id="Start_FE" name="Nutricionista abre NutriFlow">
      <outgoing>sf1</outgoing>
    </startEvent>

    <!-- ── Autenticación ── -->
    <task id="Task_Login" name="Iniciar sesión&#10;(Supabase Auth)">
      <incoming>sf1</incoming>
      <outgoing>sf2</outgoing>
    </task>

    <exclusiveGateway id="GW_AuthOk" name="¿Autenticado?">
      <incoming>sf2</incoming>
      <outgoing>sf_authYes</outgoing>
      <outgoing>sf_authNo</outgoing>
    </exclusiveGateway>

    <endEvent id="End_LoginFail" name="Acceso denegado">
      <incoming>sf_authNo</incoming>
    </endEvent>

    <!-- ── Dashboard / Selección de paciente ── -->
    <task id="Task_Dashboard" name="Ver Dashboard&#10;(lista de pacientes)">
      <incoming>sf_authYes</incoming>
      <outgoing>sf3</outgoing>
    </task>

    <exclusiveGateway id="GW_PacienteExiste" name="¿Paciente existente?">
      <incoming>sf3</incoming>
      <outgoing>sf_pacNuevo</outgoing>
      <outgoing>sf_pacExiste</outgoing>
    </exclusiveGateway>

    <task id="Task_CrearPaciente" name="Crear nuevo paciente&#10;(formulario)">
      <incoming>sf_pacNuevo</incoming>
      <outgoing>sf4</outgoing>
    </task>

    <task id="Task_SeleccionarPaciente" name="Seleccionar paciente&#10;existente">
      <incoming>sf_pacExiste</incoming>
      <outgoing>sf5</outgoing>
    </task>

    <!-- ── Flujo clínico ── -->
    <task id="Task_RegistrarEval" name="Registrar evaluación&#10;antropométrica">
      <incoming>sf4</incoming>
      <incoming>sf5</incoming>
      <outgoing>sf6</outgoing>
    </task>

    <task id="Task_VerDashboard" name="Ver dashboard clínico&#10;(solicitar TMB)">
      <incoming>sf6</incoming>
      <outgoing>sf7</outgoing>
    </task>

    <task id="Task_ConfigMacros" name="Configurar macronutrientes&#10;(% proteína, grasa, CHO)">
      <incoming>sf7</incoming>
      <outgoing>sf8</outgoing>
    </task>

    <task id="Task_ArmadoPorciones" name="Armar pauta de porciones&#10;(pizarra drag &amp; drop)">
      <incoming>sf8</incoming>
      <outgoing>sf9</outgoing>
    </task>

    <task id="Task_GuardarPauta" name="Guardar distribución&#10;de porciones">
      <incoming>sf9</incoming>
      <outgoing>sf10</outgoing>
    </task>

    <task id="Task_GuardarPlanificacion" name="Guardar planificación&#10;nutricional">
      <incoming>sf10</incoming>
      <outgoing>sf11</outgoing>
    </task>

    <exclusiveGateway id="GW_GenerarMenu" name="¿Generar menús?">
      <incoming>sf11</incoming>
      <outgoing>sf_menuSi</outgoing>
      <outgoing>sf_menuNo</outgoing>
    </exclusiveGateway>

    <task id="Task_SolicitarMenus" name="Solicitar sugerencias&#10;de menús">
      <incoming>sf_menuSi</incoming>
      <outgoing>sf12</outgoing>
    </task>

    <task id="Task_ExportarPDF" name="Exportar pauta&#10;como PDF">
      <incoming>sf12</incoming>
      <incoming>sf_menuNo</incoming>
      <outgoing>sf_end</outgoing>
    </task>

    <endEvent id="End_FE" name="Consulta finalizada">
      <incoming>sf_end</incoming>
    </endEvent>

    <!-- Sequence flows -->
    <sequenceFlow id="sf1"          sourceRef="Start_FE"              targetRef="Task_Login" />
    <sequenceFlow id="sf2"          sourceRef="Task_Login"            targetRef="GW_AuthOk" />
    <sequenceFlow id="sf_authYes"   sourceRef="GW_AuthOk"             targetRef="Task_Dashboard"           name="Sí" />
    <sequenceFlow id="sf_authNo"    sourceRef="GW_AuthOk"             targetRef="End_LoginFail"            name="No" />
    <sequenceFlow id="sf3"          sourceRef="Task_Dashboard"        targetRef="GW_PacienteExiste" />
    <sequenceFlow id="sf_pacNuevo"  sourceRef="GW_PacienteExiste"     targetRef="Task_CrearPaciente"       name="No existe" />
    <sequenceFlow id="sf_pacExiste" sourceRef="GW_PacienteExiste"     targetRef="Task_SeleccionarPaciente" name="Existe" />
    <sequenceFlow id="sf4"          sourceRef="Task_CrearPaciente"    targetRef="Task_RegistrarEval" />
    <sequenceFlow id="sf5"          sourceRef="Task_SeleccionarPaciente" targetRef="Task_RegistrarEval" />
    <sequenceFlow id="sf6"          sourceRef="Task_RegistrarEval"    targetRef="Task_VerDashboard" />
    <sequenceFlow id="sf7"          sourceRef="Task_VerDashboard"     targetRef="Task_ConfigMacros" />
    <sequenceFlow id="sf8"          sourceRef="Task_ConfigMacros"     targetRef="Task_ArmadoPorciones" />
    <sequenceFlow id="sf9"          sourceRef="Task_ArmadoPorciones"  targetRef="Task_GuardarPauta" />
    <sequenceFlow id="sf10"         sourceRef="Task_GuardarPauta"     targetRef="Task_GuardarPlanificacion" />
    <sequenceFlow id="sf11"         sourceRef="Task_GuardarPlanificacion" targetRef="GW_GenerarMenu" />
    <sequenceFlow id="sf_menuSi"    sourceRef="GW_GenerarMenu"        targetRef="Task_SolicitarMenus"      name="Sí" />
    <sequenceFlow id="sf_menuNo"    sourceRef="GW_GenerarMenu"        targetRef="Task_ExportarPDF"         name="No" />
    <sequenceFlow id="sf12"         sourceRef="Task_SolicitarMenus"   targetRef="Task_ExportarPDF" />
    <sequenceFlow id="sf_end"       sourceRef="Task_ExportarPDF"      targetRef="End_FE" />
  </process>

  <!-- ═══════════════════════════════════════════════════════════
       PROCESO: BACKEND-CORE (NestJS)
       ═══════════════════════════════════════════════════════════ -->
  <process id="Process_BackendCore" name="backend-core NestJS" isExecutable="false">

    <!-- Auth -->
    <task id="Task_BC_ValidarJWT" name="Validar JWT Supabase&#10;(JwtStrategy / Passport)">
      <outgoing>bc_sf1</outgoing>
    </task>
    <endEvent id="End_BC_Auth" name="Token validado">
      <incoming>bc_sf1</incoming>
    </endEvent>

    <!-- Pacientes CRUD -->
    <task id="Task_BC_CrearPaciente" name="POST /pacientes&#10;(PacientesService → Prisma)">
      <outgoing>bc_sf2</outgoing>
    </task>
    <endEvent id="End_BC_Pac" name="Paciente persistido">
      <incoming>bc_sf2</incoming>
    </endEvent>

    <!-- Evaluaciones -->
    <task id="Task_BC_GuardarEval" name="POST /evaluaciones&#10;(EvaluacionesService → Prisma)">
      <outgoing>bc_sf3</outgoing>
    </task>
    <endEvent id="End_BC_Eval" name="Evaluación guardada">
      <incoming>bc_sf3</incoming>
    </endEvent>

    <!-- Dashboard / TMB: recibe del FE, llama a backend-math -->
    <task id="Task_BC_ObtenerMetricas" name="GET /dashboard-clinico/:id&#10;(CalculosController)">
      <outgoing>bc_sf4</outgoing>
    </task>
    <task id="Task_BC_LlamarTMB" name="MathEngineService&#10;→ POST /api/calculadoras/tmb&#10;(sin caché)">
      <incoming>bc_sf4</incoming>
      <outgoing>bc_sf5</outgoing>
    </task>
    <endEvent id="End_BC_TMB" name="TMB + pesos retornados al FE">
      <incoming>bc_sf5</incoming>
    </endEvent>

    <!-- Macronutrientes: recibe del FE, llama al cuadrador con caché Redis -->
    <task id="Task_BC_GuardarMacros" name="POST /dashboard-clinico/macronutrientes&#10;(GuardarDistribucionMacrosDto)">
      <outgoing>bc_sf6</outgoing>
    </task>
    <task id="Task_BC_LlamarCuadrador" name="MathEngineService&#10;→ POST /api/calculadoras/cuadrador&#10;(Redis TTL 24h)">
      <incoming>bc_sf6</incoming>
      <outgoing>bc_sf7</outgoing>
    </task>
    <endEvent id="End_BC_Macros" name="Distribución macros retornada al FE">
      <incoming>bc_sf7</incoming>
    </endEvent>

    <!-- Armado de pauta: obtener distribución -->
    <task id="Task_BC_ObtenerDistribucion" name="GET /pautas/armador/:id&#10;(PautasService → MathEngine)">
      <outgoing>bc_sf8</outgoing>
    </task>
    <task id="Task_BC_ArmarPauta" name="MathEngineService&#10;→ POST /api/calculadoras/pautas/armar-pauta">
      <incoming>bc_sf8</incoming>
      <outgoing>bc_sf9</outgoing>
    </task>
    <endEvent id="End_BC_Armador" name="Pauta calculada retornada">
      <incoming>bc_sf9</incoming>
    </endEvent>

    <!-- Guardar distribución porciones + validar pizarra -->
    <task id="Task_BC_GuardarDistribucion" name="POST /pautas/guardar-distribucion&#10;(PautasService → Prisma)">
      <outgoing>bc_sf10</outgoing>
    </task>
    <task id="Task_BC_ValidarPizarra" name="MathEngineService&#10;→ POST /api/calculadoras/pizarra/validar-pizarra">
      <incoming>bc_sf10</incoming>
      <outgoing>bc_sf11</outgoing>
    </task>
    <endEvent id="End_BC_Dist" name="Distribución guardada y validada">
      <incoming>bc_sf11</incoming>
    </endEvent>

    <!-- Planificación -->
    <task id="Task_BC_CrearPlanificacion" name="POST /planificaciones&#10;(PlanificacionesService → Prisma)">
      <outgoing>bc_sf12</outgoing>
    </task>
    <endEvent id="End_BC_Plan" name="Planificación creada">
      <incoming>bc_sf12</incoming>
    </endEvent>

    <!-- Menús -->
    <task id="Task_BC_ProxyMenus" name="POST /menus/generar&#10;(MenusService → MathEngine)">
      <outgoing>bc_sf13</outgoing>
    </task>
    <task id="Task_BC_GenerarMenus" name="MathEngineService&#10;→ POST /api/calculadoras/menus/sugerir">
      <incoming>bc_sf13</incoming>
      <outgoing>bc_sf14</outgoing>
    </task>
    <endEvent id="End_BC_Menu" name="Sugerencias retornadas al FE">
      <incoming>bc_sf14</incoming>
    </endEvent>

    <!-- Sequence flows BC -->
    <sequenceFlow id="bc_sf1"  sourceRef="Task_BC_ValidarJWT"          targetRef="End_BC_Auth" />
    <sequenceFlow id="bc_sf2"  sourceRef="Task_BC_CrearPaciente"        targetRef="End_BC_Pac" />
    <sequenceFlow id="bc_sf3"  sourceRef="Task_BC_GuardarEval"          targetRef="End_BC_Eval" />
    <sequenceFlow id="bc_sf4"  sourceRef="Task_BC_ObtenerMetricas"      targetRef="Task_BC_LlamarTMB" />
    <sequenceFlow id="bc_sf5"  sourceRef="Task_BC_LlamarTMB"            targetRef="End_BC_TMB" />
    <sequenceFlow id="bc_sf6"  sourceRef="Task_BC_GuardarMacros"        targetRef="Task_BC_LlamarCuadrador" />
    <sequenceFlow id="bc_sf7"  sourceRef="Task_BC_LlamarCuadrador"      targetRef="End_BC_Macros" />
    <sequenceFlow id="bc_sf8"  sourceRef="Task_BC_ObtenerDistribucion"  targetRef="Task_BC_ArmarPauta" />
    <sequenceFlow id="bc_sf9"  sourceRef="Task_BC_ArmarPauta"           targetRef="End_BC_Armador" />
    <sequenceFlow id="bc_sf10" sourceRef="Task_BC_GuardarDistribucion"  targetRef="Task_BC_ValidarPizarra" />
    <sequenceFlow id="bc_sf11" sourceRef="Task_BC_ValidarPizarra"       targetRef="End_BC_Dist" />
    <sequenceFlow id="bc_sf12" sourceRef="Task_BC_CrearPlanificacion"   targetRef="End_BC_Plan" />
    <sequenceFlow id="bc_sf13" sourceRef="Task_BC_ProxyMenus"           targetRef="Task_BC_GenerarMenus" />
    <sequenceFlow id="bc_sf14" sourceRef="Task_BC_GenerarMenus"         targetRef="End_BC_Menu" />
  </process>

  <!-- ═══════════════════════════════════════════════════════════
       PROCESO: BACKEND-MATH (FastAPI)
       ═══════════════════════════════════════════════════════════ -->
  <process id="Process_BackendMath" name="backend-math FastAPI" isExecutable="false">

    <!-- TMB -->
    <task id="Task_BM_CalcTMB" name="POST /api/calculadoras/tmb&#10;Harris-Benedict + Mifflin&#10;+ pesos de referencia">
      <outgoing>bm_sf1</outgoing>
    </task>
    <endEvent id="End_BM_TMB" name="ResultadoTMB retornado">
      <incoming>bm_sf1</incoming>
    </endEvent>

    <!-- Cuadrador macros -->
    <task id="Task_BM_Cuadrador" name="POST /api/calculadoras/cuadrador&#10;Distribución de macros&#10;(% o g/kg estrategia)">
      <outgoing>bm_sf2</outgoing>
    </task>
    <endEvent id="End_BM_Cuad" name="OutputCuadrador retornado">
      <incoming>bm_sf2</incoming>
    </endEvent>

    <!-- Armador de pauta -->
    <task id="Task_BM_ArmarPauta" name="POST /api/calculadoras/pautas/armar-pauta&#10;Suma kcal + macros por grupos&#10;alimentarios">
      <outgoing>bm_sf3</outgoing>
    </task>
    <endEvent id="End_BM_Pauta" name="OutputPauta retornado">
      <incoming>bm_sf3</incoming>
    </endEvent>

    <!-- Pizarra -->
    <task id="Task_BM_ValidarPizarra" name="POST /api/calculadoras/pizarra/validar-pizarra&#10;Validar que porciones por tiempos&#10;de comida cuadren con pauta total">
      <outgoing>bm_sf4</outgoing>
    </task>
    <exclusiveGateway id="GW_PizarraOk" name="¿Distribución válida?">
      <incoming>bm_sf4</incoming>
      <outgoing>bm_sf5_ok</outgoing>
      <outgoing>bm_sf5_err</outgoing>
    </exclusiveGateway>
    <endEvent id="End_BM_PizOk" name="200 – Distribución válida">
      <incoming>bm_sf5_ok</incoming>
    </endEvent>
    <endEvent id="End_BM_PizErr" name="422 – Error de validación Pydantic">
      <incoming>bm_sf5_err</incoming>
      <errorEventDefinition id="ErrDef_422" errorRef="Error_422" />
    </endEvent>

    <!-- Menús -->
    <task id="Task_BM_SugerirMenus" name="POST /api/calculadoras/menus/sugerir&#10;Sugerencias de preparaciones&#10;por alimento + porción">
      <outgoing>bm_sf6</outgoing>
    </task>
    <endEvent id="End_BM_Menu" name="Lista de menús retornada">
      <incoming>bm_sf6</incoming>
    </endEvent>

    <!-- Sequence flows BM -->
    <sequenceFlow id="bm_sf1"     sourceRef="Task_BM_CalcTMB"        targetRef="End_BM_TMB" />
    <sequenceFlow id="bm_sf2"     sourceRef="Task_BM_Cuadrador"       targetRef="End_BM_Cuad" />
    <sequenceFlow id="bm_sf3"     sourceRef="Task_BM_ArmarPauta"      targetRef="End_BM_Pauta" />
    <sequenceFlow id="bm_sf4"     sourceRef="Task_BM_ValidarPizarra"  targetRef="GW_PizarraOk" />
    <sequenceFlow id="bm_sf5_ok"  sourceRef="GW_PizarraOk"            targetRef="End_BM_PizOk"  name="Válida" />
    <sequenceFlow id="bm_sf5_err" sourceRef="GW_PizarraOk"            targetRef="End_BM_PizErr" name="Inválida" />
    <sequenceFlow id="bm_sf6"     sourceRef="Task_BM_SugerirMenus"    targetRef="End_BM_Menu" />
  </process>

  <!-- ═══════════════════════════════════════════════════════════
       Errors
       ═══════════════════════════════════════════════════════════ -->
  <error id="Error_422" name="HTTP 422 Unprocessable Entity" errorCode="422" />

  <!-- ═══════════════════════════════════════════════════════════
       DIAGRAM (layout)
       ═══════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="Diagram_NutriFlow">
    <bpmndi:BPMNPlane id="Plane_NutriFlow" bpmnElement="NutriFlow_Collaboration">

      <!-- ── Pool Frontend (y=20, h=420) ── -->
      <bpmndi:BPMNShape id="Shape_Pool_Frontend" bpmnElement="Pool_Frontend" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1800" height="420" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start_FE" bpmnElement="Start_FE">
        <dc:Bounds x="72" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="50" y="245" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_Login" bpmnElement="Task_Login">
        <dc:Bounds x="150" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_AuthOk" bpmnElement="GW_AuthOk" isMarkerVisible="true">
        <dc:Bounds x="315" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="300" y="252" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_End_LoginFail" bpmnElement="End_LoginFail">
        <dc:Bounds x="317" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="295" y="75" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_Dashboard" bpmnElement="Task_Dashboard">
        <dc:Bounds x="420" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_PacienteExiste" bpmnElement="GW_PacienteExiste" isMarkerVisible="true">
        <dc:Bounds x="595" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="570" y="252" width="100" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_CrearPaciente" bpmnElement="Task_CrearPaciente">
        <dc:Bounds x="700" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_SeleccionarPaciente" bpmnElement="Task_SeleccionarPaciente">
        <dc:Bounds x="700" y="270" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_RegistrarEval" bpmnElement="Task_RegistrarEval">
        <dc:Bounds x="880" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_VerDashboard" bpmnElement="Task_VerDashboard">
