# ---- Base de datos (Supabase / PostgreSQL) ----
# Conexión vía pooler (puerto 6543) usada por la app en runtime
DATABASE_URL="postgresql://user:password@host:port/dbname"

# Conexión directa (puerto 5432) usada para migraciones y `prisma db pull`
DIRECT_URL="postgresql://user:password@host:port/dbname"

# ---- Supabase Auth ----
SUPABASE_JWT_SECRET="your-jwt-secret-here"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"

# ---- Redis (Upstash) — REST API ----
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token-here"

# ---- Servicios externos / deploy ----
# URL base del motor matemático (backend-math). Local: http://localhost:8000
MATH_ENGINE_URL="http://localhost:8000"
# Orígenes permitidos por CORS (frontend), separados por coma.
# Vacío/ausente = se reflejan todos los orígenes (solo conviene en desarrollo).
FRONTEND_URL="http://localhost:5173"
