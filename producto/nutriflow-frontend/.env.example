# ---- Backend-core (NestJS) ----
# En local: http://localhost:3000 | En producción: la URL pública del backend desplegado
VITE_API_URL="http://localhost:3000"

# ---- Supabase (cliente) ----
# Solo claves PÚBLICAS. Nunca pongas secretos (JWT secret, tokens de Redis, etc.)
# con prefijo VITE_, porque Vite los empaqueta en el bundle visible del navegador.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key-here"
